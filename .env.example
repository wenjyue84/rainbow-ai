DIGIMAN_API_URL=https://admin.southern-homestay.com
DIGIMAN_API_TOKEN=your-admin-token-here

# Legacy aliases (optional, backward compatible)
# PELANGI_API_URL=
# PELANGI_API_TOKEN=
MCP_SERVER_PORT=3002
NODE_ENV=production

# Shared Postgres for config sync (both servers use the SAME URL)
# Without this, configs are stored in local JSON files only (no cross-server sync)
# Use the POOLER (connection-pooling) endpoint for the application pool:
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Direct (non-pooler) Neon connection for schema migrations and session-dependent operations.
# Drizzle Kit (db:push, db:migrate) needs a direct connection because PgBouncer in
# transaction mode cannot handle the multi-statement DDL sessions that migrations require.
# Get this from the Neon console → Connection Details → toggle "Pooled connection" OFF.
# Falls back to DATABASE_URL if not set, but a warning is logged.
DATABASE_DIRECT_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional: Override default paths (useful for testing or custom deployments)
# RAINBOW_KB_DIR=
# WHATSAPP_AUTH_DIR=
# WHATSAPP_DATA_DIR=

# Failover coordination (primary/standby dual-server setup)
# Set RAINBOW_ROLE=primary on local PC, RAINBOW_ROLE=standby on Lightsail
# Generate shared secret: openssl rand -hex 16
RAINBOW_ROLE=primary
RAINBOW_PEER_URL=http://18.142.14.142:3002
RAINBOW_FAILOVER_SECRET=generate-with-openssl-rand-hex-16

# Meta CA certificate for mTLS webhook continuity (US-478)
# Meta is replacing DigiCert with its own CA effective 2026-04-01.
# Replace deploy/certs/meta-outbound-api-ca-2025-12.pem with the real cert,
# then set this to the absolute path on the server. Managed via ecosystem.config.cjs in production.
# NODE_EXTRA_CA_CERTS=/var/www/rainbow-ai/deploy/certs/meta-outbound-api-ca-2025-12.pem

# HTTP server timeout tuning (US-481)
# keepAliveTimeout must exceed load balancer idle timeout (AWS ALB default: 60s)
# headersTimeout must exceed keepAliveTimeout per Node.js recommendation
SERVER_KEEP_ALIVE_TIMEOUT=65000
SERVER_HEADERS_TIMEOUT=66000
SERVER_REQUEST_TIMEOUT=30000

# AWS Secrets Manager (US-499)
# Set USE_SECRETS_MANAGER=true in production to fetch DATABASE_URL, API keys, and
# other secrets from AWS Secrets Manager instead of this .env file.
# The Lightsail instance IAM role must have secretsmanager:GetSecretValue permission.
# Secrets are cached in memory with a 1-hour TTL and auto-refreshed (no restart needed).
# Set to false (or omit) for local development — .env file values are used instead.
# USE_SECRETS_MANAGER=true
# AWS_SECRET_NAME=rainbow-ai/prod
# AWS_REGION=ap-southeast-1

# ─── Meta Graph API Version (US-961) ─────────────────────────────────
# Target Graph API version for all Meta/WhatsApp API calls.
# Meta follows quarterly deprecation — keep this at v21.0 or later.
# META_GRAPH_API_VERSION=v21.0

# Business Configuration (Optional)
# BUSINESS_NAME="digiman"
# BUSINESS_LOCATION="Johor Bahru, Malaysia"
# BOT_NAME="Rainbow"
# STAFF_PRIMARY_PHONE="+60127088789"
# ADMIN_SITE_URL="https://admin.yourbusiness.com"
# PUBLIC_SITE_URL="https://yourbusiness.com"

# ─── Admin 2FA (US-514) ──────────────────────────────────────────────
# 256-bit hex key for AES-256-GCM encryption of TOTP secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TOTP_ENCRYPTION_KEY=
# Issuer name shown in authenticator apps (default: "Rainbow AI")
# TOTP_ISSUER=Rainbow AI

# ─── FnB AI Waiter Integration (US-602) ──────────────────────────────
# URL of the fnb-online-ordering MCP endpoint
# FNB_MCP_URL=http://localhost:3031/api/mcp
# Shared secret for admin MCP tools (optional for public tools)
# FNB_MCP_SECRET=

