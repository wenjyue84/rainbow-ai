DIGIMAN_API_URL=https://admin.southern-homestay.com
DIGIMAN_API_TOKEN=your-admin-token-here

MCP_SERVER_PORT=8080
NODE_ENV=production

# SQLite database path (default: ./data/rainbow-ai.db)
SQLITE_PATH=/opt/rainbow-ai/data/rainbow-ai.db

# Optional: Override default paths (useful for testing or custom deployments)
# RAINBOW_KB_DIR=
# WHATSAPP_AUTH_DIR=
# WHATSAPP_DATA_DIR=

# HTTP server timeout tuning
# keepAliveTimeout must exceed load balancer idle timeout
SERVER_KEEP_ALIVE_TIMEOUT=65000
SERVER_HEADERS_TIMEOUT=66000
SERVER_REQUEST_TIMEOUT=30000

# Business Configuration (Optional)
# BUSINESS_NAME="digiman"
# BUSINESS_LOCATION="Johor Bahru, Malaysia"
# BOT_NAME="Rainbow"
# STAFF_PRIMARY_PHONE="+60127088789"
# ADMIN_SITE_URL="https://admin.yourbusiness.com"
# PUBLIC_SITE_URL="https://yourbusiness.com"

# ─── Admin 2FA ───────────────────────────────────────────────────────
# 256-bit hex key for AES-256-GCM encryption of TOTP secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TOTP_ENCRYPTION_KEY=
# TOTP_ISSUER=Rainbow AI

# ─── FnB AI Waiter Integration ───────────────────────────────────────
# FNB_MCP_URL=http://localhost:3031/api/mcp
# FNB_MCP_SECRET=

# ─── MM Lite / Meta Cloud API ────────────────────────────────────────
# META_ACCESS_TOKEN=
# WABA_PHONE_NUMBER_ID=
# WABA_BUSINESS_ID=
