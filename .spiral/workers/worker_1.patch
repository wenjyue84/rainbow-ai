-
-      result.updated.push(menuItem.name);
-      console.log(`[InventorySync] ${menuItem.name}: ${menuItem.available ? 'available' : 'unavailable'} -> ${newAvailable ? 'available' : 'unavailable'} (qty: ${update.quantity}, source: ${source})`);
-    } catch (err: any) {
