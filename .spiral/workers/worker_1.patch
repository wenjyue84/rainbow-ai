-    `, [profileId]),
-  ]);
-
-  const totalSent = logResult.rows[0]?.total_sent ?? 0;
-  const totalDelivered = logResult.rows[0]?.total_delivered ?? 0;
-
-  const byType: Record<string, { sent: number; delivered: number }> = {};
