-  // object/embed injection
-  /<object[\s>]/gi,
-  /<embed[\s>]/gi,
-  // SVG with scripts
-  /<svg[\s>][\s\S]*?<script/gi,
-  // Base tag hijacking
-  /<base[\s>]/gi,
-  // Form injection
-  /<form[\s>]/gi,
-  // Meta refresh
-  /<meta[\s>]/gi,
