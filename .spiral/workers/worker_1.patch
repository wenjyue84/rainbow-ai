+      } catch (error) {
+        logger.error('Failed to send follow-up message for negative reaction', {
+          phone,
+          error,
+        });
+      }
+    }
+  } catch (error) {
+    logger.error('Failed to process reaction event', { phone, messageId, emoji, error });
+  }
+}
