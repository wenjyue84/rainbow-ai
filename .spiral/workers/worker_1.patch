-  const menuItem = getMenuItem(profile, itemId);
-  if (!menuItem) {
-    return { success: false, error: `Menu item "${itemId}" not found for profile "${profile}"` };
-  }
-
-  if (menuItem.available === available) {
-    return {
-      success: true,
-      item: {
-        id: menuItem.id,
-        name: menuItem.name,
-        category: menuItem.category,
-        price: menuItem.price,
