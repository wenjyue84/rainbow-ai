-       VALUES ($1, $2, $3, $4, $5, $6, $7, $8)`,
-      [
-        transition.item_id,
-        transition.item_name,
-        transition.profile,
-        transition.previous_available,
-        transition.new_available,
-        transition.quantity,
-        transition.source,
-        transition.changed_by,
-      ]
-    );
-  } catch (err: any) {
-    console.error('[InventorySync] Failed to log transition:', err.message);
-  }
