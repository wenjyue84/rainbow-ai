-  // Resolve contact for this message
-  const contact = contactMap.get(msg.from) ?? {};
-  const pushName = contact.profile?.name ?? 'Unknown';
-
-  // US-926: Determine from (phone) and bsuid
-  // - wa_id is the phone number, user_id is the BSUID
