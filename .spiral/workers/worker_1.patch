-
-// ─── Send Notifications ──────────────────────────────────────────────
-
-export interface PushPayload {
-  title: string;
-  body: string;
-  url?: string;
-  type: 'order_ready' | 'promotion' | 'incomplete_order';
-  profileId?: string;
