+
+    logger.info('Reaction feedback recorded', {
+      phone,
+      messageId,
+      emoji,
+      rating,
+      feedbackId: inserted.id,
+    });
+
+    // If thumbs-down, send a follow-up message asking what went wrong
+    if (rating === -1) {
