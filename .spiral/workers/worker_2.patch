-        if (idleDuration >= WHATSAPP_24H_WINDOW_MS) {
-          console.log(`[CartRecovery] Skipping WhatsApp session ${sessionId} — outside 24h window`);
-          continue;
-        }
-        if (!whatsappSendFn) {
