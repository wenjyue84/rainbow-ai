-      "id": "US-837",
-      "title": "System prompt A/B experiment framework for intent response quality",
-      "priority": "medium",
-      "description": "The AI system prompt is a single static configuration with no mechanism to test variants. Minor wording changes can produce 5-15% improvements in task completion rate, but there is currently no way to measure that. An experiment framework allows operators to define two prompt variants, split live traffic, and measure resolution rate and fallback rate per variant.",
-      "acceptanceCriteria": [
-        "A new config section `experiments[].id, variants[].weight, variants[].systemPromptOverride` in settings.json is parsed and validated via Zod schema",
-        "Traffic is split by deterministic hash of the sender JID modulo total weight, ensuring the same user always gets the same variant within an experiment",
-        "Per-variant metrics (message count, fallback rate, CSAT score) are tracked in a new `experiment_metrics` DB table",
-        "Admin API `GET /api/rainbow/experiments/:id/results` returns variant comparison with confidence intervals",
-        "Experiments can be activated and deactivated without server restart via admin dashboard",
-        "When no experiment is active, system falls back to the default system prompt with zero overhead"
-      ],
-      "technicalNotes": [
-        "Add experiment resolution at the prompt-assembly step in the AI provider manager",
-        "Use `crypto.createHash('md5').update(phone + experimentId).digest('hex')` for deterministic assignment",
-        "Schema: `experiment_metrics(experiment_id, variant_id, phone_hash, message_count, fallback_count, csat_sum, window_date)`"
-      ],
-      "dependencies": [],
-      "estimatedComplexity": "large",
-      "passes": true
