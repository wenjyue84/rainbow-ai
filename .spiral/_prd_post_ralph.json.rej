-    {
-      "id": "US-982",
-      "title": "Chatbot response latency SLA monitoring with P95 alerting",
-      "priority": "medium",
-      "description": "Industry benchmarks for AI chatbots set < 3s P95 end-to-end response time as the target for acceptable UX — responses slower than this correlate with session abandonment. Rainbow AI has no structured latency tracking. Adding P95 monitoring and automated breach alerts enables proactive performance management before users experience degraded service.",
-      "acceptanceCriteria": [
-        "Every AI response records end-to-end latency: webhook receipt timestamp to WhatsApp messages.send API call completion",
-        "Admin performance dashboard shows P50, P95, and P99 latency over 1h / 24h / 7d rolling windows",
-        "Alert fires when P95 latency exceeds 5 seconds over any 15-minute rolling window",
-        "Latency breakdown by AI provider (NVIDIA, Ollama, OpenRouter) is shown to identify slow providers",
-        "High-latency responses (> 10s) are flagged with a warning badge in the conversation list view in admin"
-      ],
-      "technicalNotes": [
-        "Migration: ALTER TABLE rainbow_messages ADD COLUMN processing_latency_ms INTEGER",
-        "P95 query: SELECT PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY processing_latency_ms) FROM rainbow_messages WHERE created_at > NOW() - INTERVAL '1 hour'",
-        "Latency = time from webhook messages[].timestamp field to WhatsApp send API HTTP response",
-        "Reference benchmarks: < 3s P95 per Gartner 2024 conversational AI performance standard"
-      ],
-      "dependencies": [],
-      "estimatedComplexity": "medium",
-      "passes": false
-    },
