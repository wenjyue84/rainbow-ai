-      "id": "US-985",
-      "title": "WhatsApp Business verification status health check with admin alert",
-      "priority": "medium",
-      "description": "An unverified or suspended WhatsApp Business Account (WABA) silently blocks all outbound messaging. Meta can change account status due to policy violations, incomplete verification, or payment failures. Rainbow AI currently has no automated polling of WABA status — a status degradation can cause silent delivery failures with no admin notification until users report missing replies.",
-      "acceptanceCriteria": [
-        "Server startup check queries Meta Business API for WABA account_review_status and business_verification_status and logs the result",
-        "Scheduled health check (every 6 hours) verifies WABA status and phone number quality rating",
-        "Admin alert fires immediately when WABA status changes from VERIFIED to PENDING or FLAGGED",
-        "Admin dashboard shows a WABA verification status badge (green / amber / red) with last-checked timestamp",
-        "Phone number quality rating (GREEN / YELLOW / RED) is polled hourly and displayed alongside message volume"
-      ],
-      "technicalNotes": [
-        "WABA status query: GET /{waba-id}?fields=account_review_status,business_verification_status",
-        "Phone number quality: GET /{phone-number-id}?fields=quality_rating,display_phone_number",
-        "Also subscribe to `account_update` webhook event for real-time status change push notifications",
-        "Reference: https://developers.facebook.com/docs/whatsapp/business-management-api/whatsapp-business-accounts"
-      ],
-      "dependencies": [],
-      "estimatedComplexity": "small",
-      "passes": false
-    },
