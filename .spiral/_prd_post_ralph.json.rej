-    {
-      "id": "US-965",
-      "title": "Implement OWASP LLM04 â€” RAG knowledge base integrity validation pipeline",
-      "priority": "high",
-      "description": "OWASP LLM04:2025 (Data and Model Poisoning) identifies RAG knowledge bases as a primary attack surface: a single adversarially crafted document injected into the knowledge base can dominate retrieval and systematically manipulate responses. The current .rainbow-kb/ and .rainbow-kb-southern/ pipelines ingest markdown files without cryptographic integrity checks, source authentication, or anomaly detection, leaving the hostel assistant vulnerable to poisoned KB content.",
-      "acceptanceCriteria": [
-        "Each KB file is hashed (SHA-256) on ingest; the hash is stored in `rainbow_kb_files`; re-ingestion fails if content hash changes without explicit operator approval",
-        "KB ingest pipeline rejects documents from unverified sources (only files from the local filesystem path or an allowlisted S3 prefix are accepted)",
-        "An automated audit runs nightly comparing current KB embeddings against a signed baseline snapshot and alerts the operator on anomalies",
-        "Embedding anomaly detection flags KB documents whose cosine similarity to the centroid of their topic cluster falls below a configurable threshold (default: 2 standard deviations)",
-        "All KB ingest events (add, update, delete) are written to the `rainbow_config_audit` table with the operator identity and file hash"
-      ],
-      "technicalNotes": [
-        "CycloneDX ML-BOM format recommended for tracking data provenance â€” https://cyclonedx.org/",
-        "Embedding anomaly detection: store per-document centroid distance at ingest time; alert on significant drift",
-        "Defence-in-depth: combine semantic validation, output sanitization, and vector DB integrity checks",
-        "Reference: https://genai.owasp.org/llmrisk/llm042025-data-and-model-poisoning/"
-      ],
-      "dependencies": [],
-      "estimatedComplexity": "large",
-      "passes": false
-    },
