-      "id": "US-935",
-      "title": "WCAG 2.2 SC 2.4.11: ensure webchat focused elements are not fully obscured by page-level overlays",
-      "priority": "medium",
-      "description": "WCAG 2.2 SC 2.4.11 Focus Not Obscured (Minimum), Level AA, requires that no interactive element is completely hidden by sticky or overlay content when it receives keyboard focus. The webchat widget's sticky launcher and message input area may violate this when the host page has overlapping UI elements such as cookie banners or navigation bars.",
-      "acceptanceCriteria": [
-        "Tab through every interactive element in the webchat widget with a sticky page header present; no focused element is fully hidden behind any overlapping content",
-        "Automated axe-core scan reports zero violations for WCAG 2.4.11 on the webchat widget page",
-        "The chat message input, send button, quick-reply chips, and close button are each individually tested for focus visibility",
-        "CSS scroll-padding-top or padding-bottom is applied to the widget scroll container to compensate for any sticky headers"
-      ],
-      "technicalNotes": [
-        "W3C WCAG 2.4.11 understanding document: https://www.w3.org/WAI/WCAG22/Understanding/focus-not-obscured-minimum",
-        "This targets full-page overlap with host page headers/banners; the existing 'prevent focused elements from being obscured by sticky webchat header' story covers the in-widget sticky header case",
-        "Use CSS scroll-margin or dialog/inert for modal overlay handling"
-      ],
-      "dependencies": [],
-      "estimatedComplexity": "small",
-      "passes": false
-    },
