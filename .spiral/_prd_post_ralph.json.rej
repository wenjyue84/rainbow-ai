-    {
-      "id": "US-933",
-      "title": "LLM output validation: schema-check structured AI responses before downstream use",
-      "priority": "medium",
-      "description": "Google's 5 Pillars of LLM Reliability identifies output validation as essential for production systems. Rainbow AI's pipeline trusts LLM-generated JSON (e.g., extracted order items, intent classifications, slot values) without schema validation. Malformed or hallucinated structured outputs can cause silent data corruption, order submission errors, or POS integration failures when the downstream system receives unexpected shapes.",
-      "acceptanceCriteria": [
-        "All LLM responses expected to be structured JSON are parsed through a Zod schema before use",
-        "Schema validation failures are caught, logged with the raw response, and trigger a graceful retry or fallback response",
-        "The order extraction output (items, quantities, special instructions) is validated against the OrderSchema before cart mutation",
-        "Intent classification output is validated: intent must be a known enum value, confidence must be 0-1 float",
-        "Validation error rate is tracked as a metric in the analytics pipeline (target: < 1% of LLM calls)"
-      ],
-      "technicalNotes": [
-        "Reference: Google Cloud blog 'The Five Pillars of LLM Reliability' â€” Pillar 1: Output Validation",
-        "Use existing Zod schemas in src/assistant/schemas.ts as validation layer",
-        "Structured output mode (NVIDIA/OpenRouter) reduces validation failures but does not eliminate them",
-        "Add z.safeParse() wrapper around all chatWithTools responses that return structured data"
-      ],
-      "dependencies": [
-        "Fix and test: streamChatWithTools avoids redundant second provider call when first call returns text"
-      ],
-      "estimatedComplexity": "small",
-      "passes": true
-    },
-    {
-      "id": "US-934",
-      "title": "WhatsApp Flows: health and error monitoring with automated recovery alerts",
-      "priority": "medium",
-      "description": "Meta provides a dedicated Flow Health and Monitoring capability for WhatsApp Flows. Currently Rainbow AI has no observability into flow-level errors: failed endpoint calls, user abandonment, decryption failures, or timeout events. Systematic monitoring of flow health metrics enables proactive detection of broken check-in or order flows before they impact guests at scale.",
-      "acceptanceCriteria": [
-        "A scheduled job (every 15 minutes) polls the WhatsApp Flows health API and records: flow status, error count, endpoint response time, and last failure reason",
-        "An admin dashboard panel displays per-flow health status with a traffic-light indicator (healthy / degraded / broken)",
-        "If a flow's error rate exceeds 5% over a 1-hour window, a WhatsApp alert is sent to the admin number",
-        "Flow endpoint failures (non-200 responses, decryption errors) are logged with flow_id, screen_id, and error code",
-        "Recovery procedure: if a flow is marked broken, the system falls back to a text-based alternative workflow and notifies admins"
-      ],
-      "technicalNotes": [
-        "Reference: WhatsApp Flows guides â€” Flow Health and Monitoring guide section",
-        "Flows health data accessible via WhatsApp Business Management API: GET /{flow-id}/health",
-        "Error codes: 4xx = client/config error; 5xx = endpoint error; specific codes in Flows error codes reference",
-        "Integrate with existing daily fallback rate alert notification infrastructure"
-      ],
-      "dependencies": [
-        "WhatsApp Flows encrypted data-exchange endpoint for guest digital check-in"
-      ],
-      "estimatedComplexity": "medium",
-      "passes": false
-    },
