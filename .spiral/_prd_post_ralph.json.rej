-      ],
-      "dependencies": [],
-      "estimatedComplexity": "medium",
-      "passes": false
-    },
-    {
-      "id": "US-974",
-      "title": "Implement cross-session conversation memory with summarisation for long-term guests",
-      "priority": "medium",
-      "description": "Industry best practice for AI chatbots in 2025 is a hierarchical memory architecture: short-term (verbatim recent turns), medium-term (compressed session summaries), and long-term (key facts and preferences extracted from historical interactions). For returning hostel guests, this means the AI can recall a guest's past room preferences, dietary restrictions, or recurring issues without requiring the guest to re-state them each visit, improving service quality and reducing conversation length.",
-      "acceptanceCriteria": [
-        "After each conversation ends (session timeout or checkout), a summary of key facts (room preference, dietary needs, complaints, special requests) is extracted and stored in a per-guest memory record",
-        "On the next conversation with a returning guest (matched by phone number or BSUID), relevant memory facts are injected into the system prompt context",
-        "Memory records are stored in a dedicated `guest_memory` table with a TTL of 2 years (aligned with PDPA retention policy)",
-        "Guest can request deletion of their memory record by sending 'FORGET ME', which purges the `guest_memory` record and logs the deletion in the audit trail",
-        "Memory injection is capped at a configurable token budget (default: 500 tokens) to prevent context window overflow",
-        "Admin dashboard allows operators to view and manually edit a guest's memory record"
-      ],
-      "technicalNotes": [
-        "Short-term: last 10 conversation turns in context; Medium-term: LLM-generated summary of current session; Long-term: extracted key facts in structured JSON",
-        "Summarisation prompt should extract: preferences, complaints, special requests, room history, dietary restrictions",
-        "Memory deletion is required for PDPA right to erasure (already covered) and GDPR equivalents",
-        "Reference: https://medium.com/@nomannayeem/building-ai-agents-that-actually-remember-a-developers-guide-to-memory-management-in-2025-062fd0be80a1"
-      ],
-      "dependencies": [],
-      "estimatedComplexity": "large",
-      "passes": false
-    },
