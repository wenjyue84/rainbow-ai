-      "id": "US-936",
-      "title": "WCAG 2.2 SC 2.4.13: implement minimum focus appearance in webchat widget (2px perimeter, 3:1 contrast)",
-      "priority": "medium",
-      "description": "WCAG 2.2 SC 2.4.13 Focus Appearance, Level AA, mandates that keyboard focus indicators have a minimum area equal to a 2 CSS-pixel-thick perimeter around the focused component and a contrast ratio of at least 3:1 between focused and unfocused states. The current webchat widget uses browser default outlines that may fail in some themes and are often suppressed by global CSS resets.",
-      "acceptanceCriteria": [
-        "Every interactive element in the webchat widget (buttons, inputs, links, quick replies) has a custom focus indicator with a visible outline of at least 2px",
-        "Contrast ratio between focused and unfocused state is measured to be >= 3:1 using a contrast analyser",
-        "CSS reset rules (outline: none or outline: 0) are removed from widget styles; any remaining outline suppressions are replaced with a compliant custom style",
-        "Focus indicator passes automated checks in both the default light theme and the dark mode theme"
-      ],
-      "technicalNotes": [
-        "W3C WCAG 2.4.13 understanding document: https://www.w3.org/WAI/WCAG22/Understanding/focus-appearance.html",
-        "Minimum area formula: perimeter = 2 * (width + height) * 2px CSS pixels",
-        "Use box-shadow or outline for implementation; Sara Soueidan's focus indicator design guide: https://www.sarasoueidan.com/blog/focus-indicators/"
-      ],
-      "dependencies": [],
-      "estimatedComplexity": "small",
-      "passes": false
-    },
