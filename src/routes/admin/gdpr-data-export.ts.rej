-// ─── CSV Helpers (US-894) ───────────────────────────────────────────
-
-/** Sanitise a field value to prevent formula injection (=, +, -, @, \t, \r) */
-export function sanitizeCsvField(value: unknown): string {
-  if (value === null || value === undefined) return '';
-  let str = String(value);
-  // Strip formula-injection characters at the start of the field
-  if (/^[=+\-@\t\r]/.test(str)) {
-    str = "'" + str;
-  }
-  return str;
-}
-
-/** Escape a field for RFC 4180: double-quote if it contains comma, newline, or quote */
-function escapeCsvField(value: unknown): string {
-  const sanitized = sanitizeCsvField(value);
-  if (sanitized.includes(',') || sanitized.includes('"') || sanitized.includes('\n') || sanitized.includes('\r')) {
-    return '"' + sanitized.replace(/"/g, '""') + '"';
-  }
-  return sanitized;
-}
-
-/** Map role to direction */
-function roleToDirection(role: string): string {
-  if (role === 'user') return 'inbound';
-  if (role === 'assistant') return 'outbound';
-  return role; // system, etc.
-}
-
-const CSV_HEADERS = ['timestamp', 'direction', 'content', 'intent', 'sentiment'];
-const CSV_BOM = '\uFEFF'; // UTF-8 BOM for Excel compatibility
-
-/** Build RFC 4180 CSV from message rows */
-export function buildMessageCsv(messages: Array<{ timestamp: Date | null; role: string; content: string; intent: string | null }>): string {
-  const headerLine = CSV_HEADERS.join(',');
-  const dataLines = messages.map(m => {
-    const fields = [
-      escapeCsvField(m.timestamp ? new Date(m.timestamp).toISOString() : ''),
-      escapeCsvField(roleToDirection(m.role)),
-      escapeCsvField(m.content),
-      escapeCsvField(m.intent ?? ''),
-      escapeCsvField(''), // sentiment: not stored per-message in DB
-    ];
-    return fields.join(',');
-  });
-  return CSV_BOM + headerLine + '\r\n' + dataLines.join('\r\n') + '\r\n';
-}
