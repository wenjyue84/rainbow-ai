-// ─── Config Audit Log Tab (US-847) ─────────────────────────────────
-
-async function renderConfigAuditTab(container) {
-  container.innerHTML = `
-    <div class="bg-white border rounded-2xl p-6">
-      <h3 class="font-semibold text-lg mb-1 flex items-center gap-2">
-        <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
-          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
-            d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
-        </svg>
-        Configuration Audit Log
-      </h3>
-      <p class="text-sm text-neutral-500 mb-5">History of all configuration changes with before/after diffs. Retained for 365 days.</p>
-
-      <!-- Filters -->
-      <div class="flex flex-wrap gap-3 mb-5 items-end">
-        <div>
-          <label class="block text-xs font-medium text-neutral-600 mb-1">Admin User</label>
-          <input type="text" id="audit-filter-user" placeholder="All users"
-            class="px-3 py-2 border rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition w-40" />
-        </div>
-        <div>
-          <label class="block text-xs font-medium text-neutral-600 mb-1">From</label>
-          <input type="date" id="audit-filter-from"
-            class="px-3 py-2 border rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition" />
-        </div>
-        <div>
-          <label class="block text-xs font-medium text-neutral-600 mb-1">To</label>
-          <input type="date" id="audit-filter-to"
-            class="px-3 py-2 border rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition" />
-        </div>
-        <button onclick="loadAuditLog()"
-          class="px-6 py-2 bg-indigo-600 text-white rounded-xl hover:bg-indigo-700 transition font-bold text-sm shadow-medium">
-          Filter
-        </button>
-      </div>
-
-      <!-- Log table -->
-      <div id="audit-log-container" class="border rounded-xl overflow-hidden">
-        <div class="p-8 text-center">
-          <div class="spinner mx-auto"></div>
-          <p class="text-sm text-neutral-500 mt-2">Loading audit log...</p>
-        </div>
-      </div>
-    </div>
-  `;
-
-  loadAuditLog();
-}
-
-async function loadAuditLog() {
-  const container = document.getElementById('audit-log-container');
-  if (!container) return;
-
-  const user = (document.getElementById('audit-filter-user')?.value || '').trim();
-  const from = document.getElementById('audit-filter-from')?.value || '';
-  const to = document.getElementById('audit-filter-to')?.value || '';
-
-  let qs = '?limit=100';
-  if (user) qs += '&changed_by=' + encodeURIComponent(user);
-  if (from) qs += '&from=' + encodeURIComponent(from + 'T00:00:00Z');
-  if (to) qs += '&to=' + encodeURIComponent(to + 'T23:59:59Z');
-
-  try {
-    const result = await api('/metrics/config-audit' + qs);
-    const rows = Array.isArray(result) ? result : (result?.data || []);
-    renderAuditLogTable(container, rows);
-  } catch (e) {
-    container.innerHTML = '<div class="p-4 text-red-600 text-sm">Failed to load audit log: ' + esc(e.message || e) + '</div>';
-  }
-}
-window.loadAuditLog = loadAuditLog;
-
-function renderAuditLogTable(container, rows) {
-  if (rows.length === 0) {
-    container.innerHTML = '<div class="text-center text-neutral-400 py-12 text-sm">No audit records found for the selected filters.</div>';
-    return;
-  }
-
-  const header = `
-    <div class="grid grid-cols-12 gap-2 px-4 py-2.5 bg-neutral-100 text-[10px] font-bold text-neutral-500 uppercase tracking-widest">
-      <div class="col-span-2">Timestamp</div>
-      <div class="col-span-2">Config Key</div>
-      <div class="col-span-1">Action</div>
-      <div class="col-span-2">Changed By</div>
-      <div class="col-span-1">Version</div>
-      <div class="col-span-4">Changes</div>
-    </div>
-  `;
-
-  const rowsHtml = rows.map((r, idx) => {
-    const ts = new Date(r.created_at);
-    const timeStr = ts.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: '2-digit' }) +
-      ' ' + ts.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
-
-    const actionBadge = r.action === 'create'
-      ? '<span class="px-1.5 py-0.5 rounded bg-green-100 text-green-700 text-[10px] font-bold uppercase">create</span>'
-      : r.action === 'delete'
-        ? '<span class="px-1.5 py-0.5 rounded bg-red-100 text-red-700 text-[10px] font-bold uppercase">delete</span>'
-        : '<span class="px-1.5 py-0.5 rounded bg-blue-100 text-blue-700 text-[10px] font-bold uppercase">update</span>';
-
-    const versionStr = r.old_version != null ? r.old_version + ' → ' + r.new_version : 'v' + (r.new_version || 1);
-
-    const hasDiff = r.before_data || r.after_data;
-    const diffBtn = hasDiff
-      ? '<button onclick="toggleAuditDiff(' + idx + ')" class="text-xs text-indigo-600 hover:text-indigo-800 font-medium underline">View diff</button>'
-      : '<span class="text-xs text-neutral-300">No diff</span>';
-
-    const diffPanel = hasDiff
-      ? '<div id="audit-diff-' + idx + '" class="hidden col-span-12 px-4 pb-3"><div class="bg-neutral-50 border rounded-xl p-3 text-xs font-mono overflow-x-auto max-h-64 overflow-y-auto">' +
-        computeJsonDiff(r.before_data, r.after_data) + '</div></div>'
-      : '';
-
-    return `
-      <div class="grid grid-cols-12 gap-2 px-4 py-2.5 border-b border-neutral-100 items-center hover:bg-neutral-50 text-sm">
-        <div class="col-span-2 text-xs text-neutral-600">${esc(timeStr)}</div>
-        <div class="col-span-2 font-mono text-xs text-neutral-800 truncate" title="${esc(r.config_key)}">${esc(r.config_key)}</div>
-        <div class="col-span-1">${actionBadge}</div>
-        <div class="col-span-2 text-xs text-neutral-600 truncate">${esc(r.changed_by || 'system')}</div>
-        <div class="col-span-1 text-xs text-neutral-500">${versionStr}</div>
-        <div class="col-span-4">${diffBtn}</div>
-      </div>
-      ${diffPanel}
-    `;
-  }).join('');
-
-  container.innerHTML = header + '<div>' + rowsHtml + '</div>';
-}
-
-function toggleAuditDiff(idx) {
-  const el = document.getElementById('audit-diff-' + idx);
-  if (el) el.classList.toggle('hidden');
-}
-window.toggleAuditDiff = toggleAuditDiff;
-
-/**
- * Compute a human-readable diff between two JSON objects.
- * Highlights changed keys with color coding.
- */
-function computeJsonDiff(before, after) {
-  if (!before && !after) return '<span class="text-neutral-400">No data</span>';
-
-  // Handle case where only one side exists
-  if (!before) {
-    return '<div class="text-green-700"><strong>Created:</strong><pre class="mt-1 whitespace-pre-wrap">' +
-      esc(JSON.stringify(after, null, 2)).substring(0, 2000) + '</pre></div>';
-  }
-  if (!after) {
-    return '<div class="text-red-700"><strong>Deleted:</strong><pre class="mt-1 whitespace-pre-wrap">' +
-      esc(JSON.stringify(before, null, 2)).substring(0, 2000) + '</pre></div>';
-  }
-
-  // Both exist — compute key-level diff
-  const beforeObj = typeof before === 'string' ? JSON.parse(before) : before;
-  const afterObj = typeof after === 'string' ? JSON.parse(after) : after;
-
-  const allKeys = new Set([...Object.keys(beforeObj), ...Object.keys(afterObj)]);
-  const changes = [];
-
-  for (const key of allKeys) {
-    const bVal = JSON.stringify(beforeObj[key]);
-    const aVal = JSON.stringify(afterObj[key]);
-
-    if (bVal === aVal) continue; // No change
-
-    if (bVal === undefined) {
-      changes.push('<div class="py-0.5"><span class="text-green-700 font-bold">+ ' + esc(key) + ':</span> <span class="text-green-600">' + esc(truncateVal(aVal)) + '</span></div>');
-    } else if (aVal === undefined) {
-      changes.push('<div class="py-0.5"><span class="text-red-700 font-bold">- ' + esc(key) + ':</span> <span class="text-red-600">' + esc(truncateVal(bVal)) + '</span></div>');
-    } else {
-      changes.push(
-        '<div class="py-0.5"><span class="font-bold text-amber-700">~ ' + esc(key) + ':</span></div>' +
-        '<div class="pl-4 text-red-600">- ' + esc(truncateVal(bVal)) + '</div>' +
-        '<div class="pl-4 text-green-600">+ ' + esc(truncateVal(aVal)) + '</div>'
-      );
-    }
-  }
-
-  if (changes.length === 0) {
-    return '<span class="text-neutral-400">No visible changes (deep equality)</span>';
-  }
-
-  return '<div class="space-y-0.5">' + changes.join('') + '</div>';
-}
-
-function truncateVal(val) {
-  if (!val) return '';
-  const s = String(val);
-  return s.length > 200 ? s.substring(0, 200) + '...' : s;
-}
