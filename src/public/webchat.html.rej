-      async function subscribeToPush() {
-        try {
-          // Get VAPID public key from server
-          var keyResp = await fetch('/api/chat/' + encodeURIComponent(profile.id) + '/push/vapid-key');
-          if (!keyResp.ok) return;
-          var keyData = await keyResp.json();
-          if (!keyData.publicKey) return;
-
-          var reg = await navigator.serviceWorker.ready;
-          var subscription = await reg.pushManager.subscribe({
-            userVisibleOnly: true,
-            applicationServerKey: urlBase64ToUint8Array(keyData.publicKey),
-          });
-
-          var subJson = subscription.toJSON();
-
-          // Send subscription to server
-          await fetch('/api/chat/' + encodeURIComponent(profile.id) + '/push/subscribe', {
-            method: 'POST',
-            headers: { 'Content-Type': 'application/json' },
-            body: JSON.stringify({
-              sessionId: sessionId,
-              subscription: {
-                endpoint: subJson.endpoint,
-                keys: subJson.keys,
-              },
-            }),
-          });
-
-          localStorage.setItem(PUSH_ENABLED_KEY, '1');
-          pushSubscriptionActive = true;
-          if (notifGearBtn) notifGearBtn.style.display = 'block';
-          if (notifEnabledCheckbox) notifEnabledCheckbox.checked = true;
-        } catch (err) {
-          console.warn('[Push] Subscription failed:', err);
-        }
-      }
-
-      // Convert VAPID key to Uint8Array for pushManager.subscribe
-      function urlBase64ToUint8Array(base64String) {
-        var padding = '='.repeat((4 - base64String.length % 4) % 4);
-        var base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
-        var rawData = atob(base64);
-        var outputArray = new Uint8Array(rawData.length);
-        for (var i = 0; i < rawData.length; i++) {
-          outputArray[i] = rawData.charCodeAt(i);
-        }
-        return outputArray;
-      }
-
