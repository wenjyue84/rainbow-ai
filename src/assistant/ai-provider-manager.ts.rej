-  const baseDelay = BACKOFF_BASE_DELAY_MS * Math.pow(2, attempt);
-  const jitter = baseDelay * BACKOFF_JITTER_FACTOR * (2 * Math.random() - 1);
-  return Math.round(baseDelay + jitter);
-}
