{
  "coreFiles": ["overview.md"],
  "defaultFallback": "overview.md",
  "patterns": [
    {
      "comment": "Payment and rent queries — BM, ID, EN",
      "regex": "bayar|payment|sewa|rental|rm|ringgit|duit|bulan|month|tunggakan|arrears|transfer|receipt|resit|bukti",
      "files": ["payment.md"]
    },
    {
      "comment": "Room and tenancy queries — BM, ID, EN",
      "regex": "bilik|room|kosong|vacant|available|deposit|perjanjian|agreement|contract|keluar|move out|notice",
      "files": ["rooms.md"]
    },
    {
      "comment": "Maintenance and repair queries — BM, ID, EN",
      "regex": "rosak|repair|fix|broken|bocor|leak|aircond|kipas|lampu|light|toilet|paip|pipe|kerosakan|rusak",
      "files": ["maintenance.md"]
    },
    {
      "comment": "Contact and staff queries",
      "regex": "contact|hubungi|staf|staff|phone|telefon|nombor|number|jesi|ah ying|jay",
      "files": ["contact.md"]
    }
  ]
}
