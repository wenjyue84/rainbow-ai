{
  "patterns": [
    {
      "name": "phone_number",
      "regex": "(\\+?6?0?1[0-9]{8,9})",
      "flags": "g",
      "description": "Malaysian phone number"
    },
    {
      "name": "room_code",
      "regex": "\\b(112|151|16|teratai)[r\\s]?([0-9]{1,2})\\b",
      "flags": "i",
      "description": "Room code (e.g. 151r5, 112 r3)"
    },
    {
      "name": "amount_rm",
      "regex": "RM\\s*([0-9]+(?:\\.[0-9]{2})?)",
      "flags": "i",
      "description": "Malaysian Ringgit amount"
    }
  ]
}
