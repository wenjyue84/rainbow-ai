{
  "categories": [
    {
      "phase": "overrides",
      "description": "High-specificity patterns that must win over all other phases",
      "intents": [
        {
          "category": "emergency_override",
          "enabled": true,
          "patterns": [
            "\\b(no\\s+water|no\\s+electricity|tiada\\s+air|tiada\\s+elektrik|banjir|flood|fire|kebakaran|emergency|kecemasan|darurat)\\b"
          ]
        },
        {
          "category": "payment_made",
          "enabled": true,
          "patterns": [
            "\\b(dah|sudah|already|i\\s+have)\\s+(bayar|paid|transfer)\\b",
            "\\b(dah|sudah)\\s+transfer\\b",
            "\\bmade\\s+(?:the\\s+)?payment\\b"
          ]
        }
      ]
    },
    {
      "phase": "PRE_TENANCY",
      "description": "Prospects not yet tenants — room enquiries and viewings",
      "intents": [
        {
          "category": "viewing_request",
          "enabled": true,
          "patterns": [
            "\\b(view|tengok|visit|see\\s+the\\s+room|survey|lawatan|nak\\s+tengok|boleh\\s+tengok)\\b"
          ]
        },
        {
          "category": "availability",
          "enabled": true,
          "patterns": [
            "\\b(available|kosong|vacancy|bilik\\s+ada|ada\\s+bilik|bilik\\s+kosong|any\\s+room)\\b"
          ]
        },
        {
          "category": "pricing",
          "enabled": true,
          "patterns": [
            "\\b(sewa|harga|rent|price|rate)\\b.*\\b(bulan|month|sebulan)\\b",
            "\\bhow\\s+much\\b",
            "\\bberapa\\s+sewa\\b",
            "\\bkadar\\s+sewa\\b"
          ]
        }
      ]
    },
    {
      "phase": "ACTIVE_TENANT",
      "description": "Current tenants — payments, maintenance, tenancy lifecycle",
      "intents": [
        {
          "category": "maintenance_request",
          "enabled": true,
          "patterns": [
            "\\b(rosak|bocor|repair|fix|broken|not\\s+working|kerosakan|tolong\\s+betulkan)\\b",
            "\\b(aircond|air\\s+cond|paip|pipe|lampu|light|toilet|pintu|door|tingkap|window|elektrik|electrical)\\b.*\\b(rosak|bocor|problem|issue|broken|mati|tak\\s+jalan)\\b"
          ]
        },
        {
          "category": "payment_info",
          "enabled": true,
          "patterns": [
            "\\b(account|akaun|bank|transfer|cara\\s+bayar|how\\s+to\\s+pay|nombor\\s+akaun|no\\s+akaun)\\b"
          ]
        },
        {
          "category": "move_out",
          "enabled": true,
          "patterns": [
            "\\b(nak\\s+keluar|move\\s+out|vacate|terminate|end\\s+tenancy|notice|notis\\s+keluar|nak\\s+pindah)\\b"
          ]
        },
        {
          "category": "lease_renewal",
          "enabled": true,
          "patterns": [
            "\\b(renew|extend|sambung|continue\\s+rent|perpanjang|sambung\\s+sewa)\\b"
          ]
        },
        {
          "category": "deposit_inquiry",
          "enabled": true,
          "patterns": [
            "\\b(deposit|security\\s+deposit|dapat\\s+balik\\s+deposit|pulangan\\s+deposit|refund\\s+deposit|bila\\s+dapat\\s+balik)\\b"
          ]
        },
        {
          "category": "utilities",
          "enabled": true,
          "patterns": [
            "\\b(electricity\\s+bill|water\\s+bill|bil\\s+elektrik|bil\\s+air|utility|TNB|siapa\\s+bayar\\s+bil|bil\\s+termasuk)\\b"
          ]
        },
        {
          "category": "move_in",
          "enabled": true,
          "patterns": [
            "\\b(move\\s+in|masuk\\s+bila|ambil\\s+kunci|key\\s+collection|collect\\s+key|bila\\s+boleh\\s+masuk)\\b"
          ]
        }
      ]
    }
  ]
}
