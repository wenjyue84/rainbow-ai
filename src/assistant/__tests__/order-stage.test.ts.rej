-// ─── US-881: Order Modification Window Tests ────────────────────────
-
-import {
-  saveModificationSnapshot, isModificationAllowed,
-  getModificationSnapshot, clearModificationWindow,
-  markKitchenAccepted, getModificationRemainingSeconds,
-  setActiveModification, consumeActiveModification,
-} from '../order-modification-store.js';
-
-describe('Order Modification Store — unit tests (US-881)', () => {
-  const newSid = () => 'mod-unit-' + Date.now() + '-' + Math.random();
-
-  it('saves and retrieves a modification snapshot', () => {
-    const sid = newSid();
-    const items = [{ name: 'Nasi Lemak', qty: 1, price: 8.50 }];
-    saveModificationSnapshot(sid, items, 120000, { orderId: 'MM-TEST1' });
-
-    const snapshot = getModificationSnapshot(sid);
-    expect(snapshot).toBeDefined();
-    expect(snapshot!.items).toHaveLength(1);
-    expect(snapshot!.items[0].name).toBe('Nasi Lemak');
-    expect(snapshot!.orderId).toBe('MM-TEST1');
-    expect(snapshot!.kitchenAccepted).toBe(false);
-    clearModificationWindow(sid);
-  });
-
-  it('isModificationAllowed returns true within window', () => {
-    const sid = newSid();
-    saveModificationSnapshot(sid, [{ name: 'Test', qty: 1 }], 120000);
-    expect(isModificationAllowed(sid)).toBe(true);
-    clearModificationWindow(sid);
-  });
-
-  it('isModificationAllowed returns false after window expires', () => {
-    const sid = newSid();
-    saveModificationSnapshot(sid, [{ name: 'Test', qty: 1 }], 1); // 1ms window
-    // Wait for window to expire
-    const start = Date.now();
-    while (Date.now() - start < 5) { /* spin */ }
-    expect(isModificationAllowed(sid)).toBe(false);
-    clearModificationWindow(sid);
-  });
-
-  it('isModificationAllowed returns false after kitchen acceptance', () => {
-    const sid = newSid();
-    saveModificationSnapshot(sid, [{ name: 'Test', qty: 1 }], 120000);
-    markKitchenAccepted(sid);
-    expect(isModificationAllowed(sid)).toBe(false);
-    clearModificationWindow(sid);
-  });
-
-  it('markKitchenAccepted returns false for unknown session', () => {
-    expect(markKitchenAccepted('nonexistent-session')).toBe(false);
-  });
-
-  it('getModificationRemainingSeconds returns positive value within window', () => {
-    const sid = newSid();
-    saveModificationSnapshot(sid, [{ name: 'Test', qty: 1 }], 120000);
-    const remaining = getModificationRemainingSeconds(sid);
-    expect(remaining).toBeGreaterThan(0);
-    expect(remaining).toBeLessThanOrEqual(120);
-    clearModificationWindow(sid);
-  });
-
-  it('getModificationRemainingSeconds returns 0 after kitchen acceptance', () => {
-    const sid = newSid();
-    saveModificationSnapshot(sid, [{ name: 'Test', qty: 1 }], 120000);
-    markKitchenAccepted(sid);
-    expect(getModificationRemainingSeconds(sid)).toBe(0);
-    clearModificationWindow(sid);
-  });
-
-  it('clearModificationWindow removes snapshot', () => {
-    const sid = newSid();
-    saveModificationSnapshot(sid, [{ name: 'Test', qty: 1 }], 120000);
-    clearModificationWindow(sid);
-    expect(getModificationSnapshot(sid)).toBeUndefined();
-    expect(isModificationAllowed(sid)).toBe(false);
-  });
-
-  it('setActiveModification / consumeActiveModification works once', () => {
-    const sid = newSid();
-    setActiveModification(sid);
-    expect(consumeActiveModification(sid)).toBe(true);
-    expect(consumeActiveModification(sid)).toBe(false); // consumed
-  });
-});
-
-describe('Cart handlers — order_modify_request tool (US-881)', () => {
-  const newSid = () => 'mod-handler-' + Date.now() + '-' + Math.random();
-
-  it('restores cart items within modification window', async () => {
-    const sid = newSid();
-    const handlers = createCartHandlers(sid);
-
-    // Place an order first
-    await handlers.get('cart_add_item')!({ name: 'Nasi Lemak', qty: 1, price: 8.50 });
-    await handlers.get('cart_add_item')!({ name: 'Teh Tarik', qty: 2, price: 2.50 });
-    setOrderStage(sid, 'CONFIRMING');
-    const placeResult = await handlers.get('order_confirm_submit')!({ tableNumber: '5' });
-    expect(placeResult.content[0].text).toContain('kitchen');
-    expect(placeResult.content[0].text).toContain('2 minutes');
-
-    // Cart should be empty after placement
-    expect(cartGetItems(sid)).toHaveLength(0);
-
-    // Request modification within window
-    const modResult = await handlers.get('order_modify_request')!({});
-    expect(modResult.content[0].text).toContain('reopened');
-    expect(modResult.content[0].text).toContain('Nasi Lemak');
-    expect(modResult.content[0].text).toContain('Teh Tarik');
-
-    // Cart should have items restored
-    const items = cartGetItems(sid);
-    expect(items).toHaveLength(2);
-    expect(getOrderStage(sid)).toBe('ORDERING');
-
-    cartClear(sid);
-    clearOrderStage(sid);
-  });
-
-  it('rejects modification when no recent order exists', async () => {
-    const sid = newSid();
-    const handlers = createCartHandlers(sid);
-
-    const result = await handlers.get('order_modify_request')!({});
-    expect(result.content[0].text).toContain('no recent order');
-  });
-
-  it('rejects modification when window has expired', async () => {
-    const sid = newSid();
-    // Create handler with 0-minute window (immediate expiry)
-    const handlers = createCartHandlers(sid, { orderModificationWindowMinutes: 0 });
-
-    await handlers.get('cart_add_item')!({ name: 'Roti Canai', qty: 1, price: 3.50 });
-    setOrderStage(sid, 'CONFIRMING');
-    await handlers.get('order_confirm_submit')!({});
-
-    // Small delay to ensure window expires
-    await new Promise(r => setTimeout(r, 10));
-
-    const result = await handlers.get('order_modify_request')!({});
-    expect(result.content[0].text).toContain('expired');
-
-    cartClear(sid);
-    clearOrderStage(sid);
-  });
-
-  it('rejects modification when kitchen has accepted', async () => {
-    const sid = newSid();
-    const handlers = createCartHandlers(sid);
-
-    await handlers.get('cart_add_item')!({ name: 'Laksa', qty: 1, price: 10.00 });
-    setOrderStage(sid, 'CONFIRMING');
-    await handlers.get('order_confirm_submit')!({});
-
-    // Simulate kitchen acceptance
-    markKitchenAccepted(sid);
-
-    const result = await handlers.get('order_modify_request')!({});
-    expect(result.content[0].text).toContain('kitchen has already accepted');
-
-    cartClear(sid);
-    clearOrderStage(sid);
-  });
-
-  it('prevents double-restore on consecutive modify requests', async () => {
-    const sid = newSid();
-    const handlers = createCartHandlers(sid);
-
-    await handlers.get('cart_add_item')!({ name: 'Nasi Goreng', qty: 1, price: 7.50 });
-    setOrderStage(sid, 'CONFIRMING');
-    await handlers.get('order_confirm_submit')!({});
-
-    // First modify — should restore items
-    const mod1 = await handlers.get('order_modify_request')!({});
-    expect(mod1.content[0].text).toContain('reopened');
-    expect(cartGetItems(sid)).toHaveLength(1);
-    expect(cartGetItems(sid)[0].qty).toBe(1);
-
-    // Second modify — snapshot cleared, so no double-restore
-    const mod2 = await handlers.get('order_modify_request')!({});
-    expect(mod2.content[0].text).toContain('no recent order');
-    // Cart should still have only 1x Nasi Goreng from first restore
-    expect(cartGetItems(sid)).toHaveLength(1);
-    expect(cartGetItems(sid)[0].qty).toBe(1);
-
-    cartClear(sid);
-    clearOrderStage(sid);
-  });
-
-  it('modified resubmission says "updated order" without modification window note', async () => {
-    const sid = newSid();
-    const handlers = createCartHandlers(sid);
-
-    // Place initial order
-    await handlers.get('cart_add_item')!({ name: 'Mee Goreng', qty: 1, price: 6.50 });
-    setOrderStage(sid, 'CONFIRMING');
-    await handlers.get('order_confirm_submit')!({});
-
-    // Modify
-    await handlers.get('order_modify_request')!({});
-
-    // Resubmit
-    await handlers.get('order_request_confirmation')!({});
-    const resubmit = await handlers.get('order_confirm_submit')!({});
-    expect(resubmit.content[0].text).toContain('Your updated order');
-    expect(resubmit.content[0].text).not.toContain('minutes to make changes');
-
-    cartClear(sid);
-    clearOrderStage(sid);
-  });
-});
