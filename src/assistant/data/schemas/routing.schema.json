{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "routing.json",
  "description": "Intent to action mapping. Each key is an intent name; value describes the action to take.",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "type": "object",
    "required": ["action"],
    "properties": {
      "action": {
        "type": "string",
        "enum": ["static_reply", "llm_reply", "workflow"],
        "description": "Action type to take for this intent"
      },
      "workflow_id": {
        "type": "string",
        "description": "Required when action is 'workflow'"
      }
    },
    "additionalProperties": true,
    "if": {
      "properties": { "action": { "const": "workflow" } }
    },
    "then": {
      "required": ["workflow_id"]
    }
  }
}
