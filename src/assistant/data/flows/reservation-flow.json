{
  "version": "6.3",
  "data_api_version": "3.0",
  "screens": [
    {
      "id": "BOOKING_DETAILS",
      "title": "Room Reservation",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Book your stay"
          },
          {
            "type": "TextSubheading",
            "text": "Fill in the details below"
          },
          {
            "type": "DatePicker",
            "name": "check_in_date",
            "label": "Check-in Date",
            "required": true,
            "helper-text": "Select your arrival date",
            "on-select-action": {
              "name": "data_exchange",
              "payload": {
                "action": "check_availability",
                "check_in_date": "${form.check_in_date}"
              }
            }
          },
          {
            "type": "DatePicker",
            "name": "check_out_date",
            "label": "Check-out Date",
            "required": true,
            "helper-text": "Select your departure date"
          },
          {
            "type": "Dropdown",
            "name": "room_type",
            "label": "Room Type",
            "required": true,
            "data-source": "${data.room_options}"
          },
          {
            "type": "TextInput",
            "input-type": "number",
            "name": "guest_count",
            "label": "Number of Guests",
            "required": true,
            "min-chars": 1,
            "max-chars": 2,
            "helper-text": "1-12 guests"
          },
          {
            "type": "TextArea",
            "name": "special_requests",
            "label": "Special Requests (optional)",
            "required": false,
            "max-length": 600,
            "helper-text": "e.g. late check-in, extra pillows"
          },
          {
            "type": "Footer",
            "label": "Submit Reservation",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "action": "submit_reservation",
                "check_in_date": "${form.check_in_date}",
                "check_out_date": "${form.check_out_date}",
                "room_type": "${form.room_type}",
                "guest_count": "${form.guest_count}",
                "special_requests": "${form.special_requests}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "CONFIRMATION",
      "title": "Reservation Confirmed",
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Booking Confirmed!"
          },
          {
            "type": "TextBody",
            "text": "Your reservation reference: ${data.booking_ref}"
          },
          {
            "type": "TextBody",
            "text": "Check-in: ${data.check_in_date}\nCheck-out: ${data.check_out_date}\nRoom: ${data.room_type}\nGuests: ${data.guest_count}"
          },
          {
            "type": "TextBody",
            "text": "We'll send you a confirmation message shortly."
          },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "booking_ref": "${data.booking_ref}"
              }
            }
          }
        ]
      }
    }
  ]
}
