  "ORDER_BROWSE": {
    "action": "llm_reply",
    "notes": "Guest is browsing the menu: questions about items, prices, categories. No cart mutation."
  },
  "ORDER_ITEM_ADD": {
    "action": "llm_reply",
    "notes": "Guest is ordering: 'I want X', 'give me X'. Cart should be updated, order NOT submitted yet."
  },
  "ORDER_CONFIRM": {
    "action": "llm_reply",
    "notes": "Guest explicitly confirms order: 'yes', 'go ahead', 'place it'. Only submit after this intent."
  },
  "ORDER_DECLINE": {
    "action": "llm_reply",
    "notes": "Guest declines confirmation: 'no', 'wait', 'change my mind'. Return to ORDERING stage."
  },
  "ORDER_CANCEL": {
    "action": "llm_reply",
    "notes": "Guest cancels entire order: 'cancel my order', 'forget it', 'start over', 'clear my cart', 'nevermind'. Clear cart and reset to BROWSING."
  },
  "ORDER_STATUS": {
    "action": "llm_reply",
    "notes": "Guest asks about order status: 'where is my order', 'how long more', 'is my food ready', 'check order MM-XXXX'. Call order_check_status."
  },
  "MENU_FILTER_PRICE": {
    "action": "llm_reply",
    "notes": "Guest asks for menu items by price budget: 'what can I get for RM 15', 'show me items under RM 10', 'budget options', 'cheap items'. Call fnb_get_menu with max_price filter, sort cheapest first."
  },
  "MENU_SPECIALS": {
    "action": "llm_reply",
    "notes": "Guest asks about today's specials, promotions, deals, or limited items: 'what's today's special', 'any promotions', 'what's new', 'any deals'. Call fnb_get_daily_specials; show urgency for limited-quantity items."
  },
  "MENU_RECOMMEND": {
    "action": "llm_reply",
    "notes": "Guest is undecided and asks for recommendations: 'what is good', 'what do you recommend', 'what is popular', 'what should I order'. Call fnb_get_popular_items (limit 5); include name, price, and short appeal. End with CTA to add to cart."
  },
