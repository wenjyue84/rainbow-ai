{
  "ai": {
    "nvidia_model": "moonshotai/kimi-k2.5",
    "nvidia_base_url": "https://integrate.api.nvidia.com/v1",
    "groq_model": "llama-3.3-70b-versatile",
    "max_classify_tokens": 100,
    "max_chat_tokens": 800,
    "classify_temperature": 0.05,
    "chat_temperature": 0.7,
    "providers": [
      {
        "id": "google-gemini-flash",
        "name": "Google Gemini 2.5 Flash",
        "description": "Fast multimodal model, excellent for management Q&A.",
        "type": "google-gemini",
        "api_key_env": "GEMINI_API_KEY",
        "base_url": "https://generativelanguage.googleapis.com/v1beta",
        "model": "gemini-2.5-flash",
        "enabled": true,
        "priority": 0,
        "available": true
      },
      {
        "id": "groq-llama",
        "name": "Groq Llama 3.3 70B",
        "description": "Balanced quality/speed fallback.",
        "type": "groq",
        "api_key_env": "GROQ_API_KEY",
        "base_url": "https://api.groq.com/openai/v1",
        "model": "llama-3.3-70b-versatile",
        "enabled": true,
        "priority": 1,
        "available": true
      },
      {
        "id": "groq-llama-8b",
        "name": "Groq Llama 3.1 8B Instant",
        "description": "Ultra-fast classification fallback.",
        "type": "groq",
        "api_key_env": "GROQ_API_KEY",
        "base_url": "https://api.groq.com/openai/v1",
        "model": "llama-3.1-8b-instant",
        "enabled": true,
        "priority": 2,
        "available": true
      }
    ]
  },
  "routing_mode": {
    "splitModel": false,
    "classifyProvider": "groq-llama-8b",
    "tieredPipeline": false
  },
  "system_prompt": "You are an internal AI management assistant for Southern Homestay staff. You help the team with operational tasks: looking up guest information, checking room availability and status, managing reservations, handling check-in and check-out queries, reviewing maintenance issues, and answering questions about revenue, occupancy, and daily operations. You have access to the PMS2 property management system tools — use them to fetch real-time data when staff ask about guests, rooms, or bookings. Be direct, factual, and efficient. Respond in English. Do not expose sensitive system credentials. If a task requires physical action, state clearly what needs to be done.",
  "rate_limits": {
    "per_minute": 30,
    "per_hour": 200
  },
  "staff": {
    "phones": [
      "60167620815",
      "60127088789"
    ],
    "jay_phone": "60127088789",
    "alston_phone": "60167620815"
  },
  "conversation_management": {
    "enabled": true,
    "summarize_threshold": 8,
    "summarize_from_message": 1,
    "summarize_to_message": 6,
    "keep_verbatim_from": 7,
    "keep_verbatim_to": 20,
    "description": "Summarize older messages to keep context window manageable."
  },
  "sentiment_analysis": {
    "enabled": false,
    "consecutive_threshold": 2,
    "cooldown_minutes": 30
  },
  "failover": {
    "enabled": false,
    "heartbeatIntervalMs": 20000,
    "failoverThresholdMs": 60000,
    "handbackMode": "immediate",
    "handbackGracePeriodMs": 30000
  },
  "botAvatar": "🏠",
  "staffName": "PMS Assistant",
  "mcp_servers": {
    "connections": [
      {
        "id": "pms2-southern",
        "name": "PMS2 (Southern Homestay)",
        "description": "Property management system — guests, rooms, check-in/out, occupancy, availability, maintenance, reservations, and analytics.",
        "url": "http://localhost:5000/api/mcp",
        "transport": "sse",
        "auth_type": "none",
        "api_key_env": "",
        "enabled": true
      }
    ]
  },
  "response_modes": {
    "default_mode": "autopilot"
  }
}
