{
  "version": "1.0.0",
  "description": "Per-intent confidence score thresholds. Used by the classification pipeline to determine if an intent classification is reliable enough for action, or if clarifying questions should be asked.",
  "lastUpdated": "2026-04-12",
  "thresholds": {
    "greeting": 0.95,
    "thanks": 0.9,
    "contact_staff": 0.8,
    "pricing": 0.85,
    "availability": 0.7,
    "booking": 0.75,
    "directions": 0.85,
    "facilities_info": 0.67,
    "rules_policy": 0.8,
    "payment_info": 0.8,
    "payment_made": 0.67,
    "checkin_info": 0.8,
    "checkout_info": 0.8,
    "checkout_procedure": 0.8,
    "check_in_arrival": 0.67,
    "billing_inquiry": 0.8,
    "billing_dispute": 0.67,
    "cleanliness_complaint": 0.67,
    "climate_control_complaint": 0.67,
    "facility_malfunction": 0.67,
    "facility_orientation": 0.67,
    "noise_complaint": 0.67,
    "extra_amenity_request": 0.67,
    "general_complaint_in_stay": 0.6,
    "post_checkout_complaint": 0.6,
    "review_feedback": 0.8,
    "tourist_guide": 0.67,
    "luggage_storage": 0.85,
    "late_checkout_request": 0.85,
    "lower_deck_preference": 0.85,
    "forgot_item_post_checkout": 0.67,
    "card_locked": 0.3,
    "theft_report": 0.3,
    "wifi": 0.95,
    "unknown": 0.0
  },
  "categories": {
    "high_confidence_required": {
      "thresholds": [0.85, 1.0],
      "intents": ["greeting", "wifi", "pricing", "directions", "thanks", "rules_policy", "payment_info", "checkin_info", "checkout_info", "checkout_procedure", "billing_inquiry", "review_feedback", "luggage_storage", "late_checkout_request", "lower_deck_preference"],
      "description": "Critical actions that require high confidence (85%+)"
    },
    "medium_confidence_acceptable": {
      "thresholds": [0.65, 0.85],
      "intents": ["availability", "booking", "contact_staff", "facilities_info", "payment_made", "check_in_arrival", "billing_dispute", "cleanliness_complaint", "climate_control_complaint", "facility_malfunction", "facility_orientation", "noise_complaint", "extra_amenity_request", "tourist_guide", "forgot_item_post_checkout"],
      "description": "Actions that can proceed with medium confidence (65%-85%)"
    },
    "low_confidence_requires_clarification": {
      "thresholds": [0.3, 0.65],
      "intents": ["general_complaint_in_stay", "post_checkout_complaint"],
      "description": "Actions that require clarification when confidence is low (<65%)"
    },
    "emergency_thresholds": {
      "thresholds": [0.0, 0.3],
      "intents": ["card_locked", "theft_report"],
      "description": "Sensitive/emergency intents with minimal confidence threshold"
    },
    "system_intents": {
      "thresholds": [0.0, 0.0],
      "intents": ["unknown"],
      "description": "System fallback intent"
    }
  }
}
