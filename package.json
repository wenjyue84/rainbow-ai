{
  "name": "rainbow-ai",
  "version": "1.0.0",
  "type": "module",
  "description": "Rainbow AI — WhatsApp assistant for hostel management",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentation.ts src/index.ts",
    "build:dashboard": "vite build",
    "build": "esbuild src/index.ts src/instrumentation.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && node --input-type=commonjs -e \"const fs=require('fs');fs.cpSync('src/assistant/data','dist/assistant/data',{recursive:true});fs.cpSync('src/public','dist/public',{recursive:true});['data-southern','data-makan'].forEach(d=>{const s='src/assistant/'+d;if(fs.existsSync(s))fs.cpSync(s,'dist/assistant/'+d,{recursive:true})})\"",
    "start": "node --import ./dist/instrumentation.js dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --project unit",
    "test:all": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:semantic": "vitest run --project semantic",
    "test:coverage": "vitest --coverage",
    "test:eval": "npx promptfoo eval -c tests/promptfoo/promptfooconfig.yaml",
    "test:eval:view": "npx promptfoo view",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "check": "tsc --noEmit",
    "build:css": "tailwindcss -i ./src/public/css/tailwind-input.css -o ./src/public/css/tailwind.min.css --minify",
    "db:push": "drizzle-kit push"
  },
  "keywords": [
    "rainbow-ai",
    "whatsapp",
    "hostel",
    "management"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1008.0",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-metrics": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/sdk-trace-node": "^2.6.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@types/cors": "^2.8.17",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.6.0",
    "bullmq": "^5.71.0",
    "chokidar": "^4.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.7.0",
    "eld": "^2.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "fuse.js": "^7.1.0",
    "groq-sdk": "^0.37.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "otplib": "^13.3.0",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5.3.3",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.27.3",
    "fast-check": "^4.6.0",
    "happy-dom": "^20.6.1",
    "jsdom": "^28.0.0",
    "promptfoo": "^0.120.23",
    "tsx": "^4.7.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
