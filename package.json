{
  "name": "rainbow-ai",
  "version": "1.0.0",
  "type": "module",
  "description": "Rainbow AI — WhatsApp assistant for hostel management",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentation.ts --ignore src/public src/index.ts",
    "build:dashboard": "vite build",
    "build": "node scripts/validate-sri.mjs && esbuild src/index.ts src/instrumentation.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && node --input-type=commonjs -e \"const fs=require('fs');fs.cpSync('src/assistant/data','dist/assistant/data',{recursive:true});fs.cpSync('src/public','dist/public',{recursive:true});['data-southern','data-makan'].forEach(d=>{const s='src/assistant/'+d;if(fs.existsSync(s))fs.cpSync(s,'dist/assistant/'+d,{recursive:true})})\"",
    "pci:scan": "node scripts/pci-quarterly-scan.mjs",
    "start": "node --import ./dist/instrumentation.js dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --project unit",
    "test:all": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:semantic": "vitest run --project semantic",
    "test:coverage": "vitest --coverage",
    "test:eval": "npx promptfoo eval -c tests/promptfoo/promptfooconfig.yaml",
    "test:eval:view": "npx promptfoo view",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "check": "tsc --noEmit",
    "build:css": "tailwindcss -i ./src/public/css/tailwind-input.css -o ./src/public/css/tailwind.min.css --minify",
    "db:push": "drizzle-kit push"
  },
  "keywords": [
    "rainbow-ai",
    "whatsapp",
    "hostel",
    "management"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1008.0",
    "@modelcontextprotocol/sdk": "0.5.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.213.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.213.0",
    "@opentelemetry/resources": "2.6.0",
    "@opentelemetry/sdk-metrics": "2.6.0",
    "@opentelemetry/sdk-node": "0.213.0",
    "@opentelemetry/sdk-trace-node": "2.6.0",
    "@opentelemetry/semantic-conventions": "1.40.0",
    "@types/cors": "2.8.19",
    "@types/multer": "2.1.0",
    "@types/node": "20.19.37",
    "@types/node-cron": "3.0.11",
    "@types/pg": "8.18.0",
    "@types/qrcode": "1.5.6",
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "@xenova/transformers": "2.17.2",
    "axios": "1.13.6",
    "bullmq": "5.71.0",
    "chokidar": "4.0.3",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "drizzle-orm": "0.45.1",
    "drizzle-zod": "0.7.1",
    "eld": "2.0.2",
    "express": "5.2.1",
    "express-rate-limit": "8.3.1",
    "fuse.js": "7.1.0",
    "groq-sdk": "0.37.0",
    "helmet": "8.1.0",
    "ioredis": "5.10.0",
    "multer": "2.1.1",
    "node-cron": "4.2.1",
    "otplib": "13.3.0",
    "pg": "8.20.0",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0",
    "typescript": "5.9.3",
    "winston-daily-rotate-file": "5.0.0",
    "ws": "8.19.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.1"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/ui": "4.0.18",
    "drizzle-kit": "0.31.9",
    "esbuild": "0.27.3",
    "fast-check": "4.6.0",
    "happy-dom": "20.8.3",
    "jsdom": "28.1.0",
    "promptfoo": "0.120.27",
    "tsx": "4.21.0",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
