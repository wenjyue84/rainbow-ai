{
  "schemaVersion": 1,
  "productName": "rainbow-ai",
  "branchName": "spiral-worker-1-1773549790",
  "overview": "Rainbow AI is a WhatsApp AI assistant for Pelangi Capsule Hostel & Southern Homestay. It handles guest inquiries, booking workflows, and multi-turn conversations via Baileys WebSocket. The focus is on reliability, response quality, and intent classification accuracy.",
  "goals": [
    "Improve intent classification accuracy for booking and inquiry intents",
    "Enhance conversation context handling for multi-turn dialogues",
    "Add better fallback responses when AI confidence is low",
    "Improve the booking workflow steps in workflows.json",
    "Fix any failing tests",
    "Prioritize reliability and response quality over new features",
    "Enforce strict business profile separation — each profile's data files must only contain content specific to that business, with zero contamination from other profiles",
    "Fix data-makan and data-southern profiles which currently contain copy-pasted Pelangi Capsule Hostel content"
  ],
  "epics": [
    {
      "id": "E-1",
      "title": "Intent Classification Accuracy",
      "description": "Improve how the system classifies incoming messages into the correct intent categories, especially for booking and inquiry intents."
    },
    {
      "id": "E-2",
      "title": "Multi-Turn Conversation Context",
      "description": "Enhance the system's ability to track and use conversation context across multiple turns of dialogue."
    },
    {
      "id": "E-3",
      "title": "Fallback & Confidence Handling",
      "description": "Improve responses when the AI has low confidence or cannot classify an intent reliably."
    },
    {
      "id": "E-4",
      "title": "Booking Workflow Improvements",
      "description": "Improve the booking workflow steps, transitions, and validation logic in workflows.json and related pipeline code."
    },
    {
      "id": "E-5",
      "title": "Test Suite Reliability",
      "description": "Fix failing tests and improve test coverage for core intent and conversation logic."
    },
    {
      "id": "E-6",
      "title": "Business Profile Separation",
      "description": "Ensure strict data isolation between all business profiles. Each profile's data files (knowledge.json, intents.json, intent-keywords.json, routing.json, templates.json, workflows.json) must contain ONLY content specific to that business. No profile may contain identifiers, addresses, credentials, pricing, or intents belonging to a different business."
    }
  ],
