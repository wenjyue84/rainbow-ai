-    {
-      "id": "US-893",
-      "title": "WhatsApp media auto-download: save incoming images/documents before URL expiry",
-      "priority": "high",
-      "description": "WhatsApp temporary media URLs provided via webhooks expire after 24-48 hours. Currently, Rainbow AI receives image and document messages but does not eagerly download and persist the binary content. If a guest sends a photo of their ID or a booking confirmation document and the URL expires before a staff member views it, the media is permanently lost.",
-      "acceptanceCriteria": [
-        "When a Baileys message event contains imageMessage, documentMessage, or videoMessage, the binary is downloaded immediately",
-        "Downloaded file is stored on disk (or S3) under a path keyed by message ID",
-        "The conversation message record in rainbow_messages is updated with a localMediaUrl field",
-        "If the download fails, a retry is attempted up to 3 times with exponential backoff before logging to DLQ",
-        "Admin conversation view renders the locally-stored URL, not the ephemeral WhatsApp URL",
-        "Vitest test mocks the download call and asserts the localMediaUrl field is populated"
-      ],
-      "technicalNotes": [
-        "Use Baileys downloadMediaMessage() helper: it handles decryption automatically",
-        "Store under ./media/<YYYY-MM-DD>/<messageId>.<ext> and serve via a static Express route",
-        "Reference: https://wasenderapi.com/blog/how-to-receive-whatsapp-messages-via-webhook-the-ultimate-2025-guide"
-      ],
-      "dependencies": [],
-      "estimatedComplexity": "medium",
-      "passes": false,
